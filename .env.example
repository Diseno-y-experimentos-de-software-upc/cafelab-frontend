# Opcional: usado por set-env.js en prestart/prebuild para sustituir serverBaseUrl
# en environment.ts y environment.development.ts (no en local/remote: usan proxy).
# No modifica environment.local.ts (usa proxy hacia el backend en LOCAL_API_PROXY_TARGET).
#
# API_URL=https://tu-api-desplegada.example.com

# Si el backend local no está en :8080, ajusta el proxy de ng serve (solo configuración "local"):
# LOCAL_API_PROXY_TARGET=http://localhost:8080
